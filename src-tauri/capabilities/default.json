{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "index",
    "shared-files",
    "app-config"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default",
    "core:event:allow-listen",
    "core:window:allow-start-dragging",
    "dialog:allow-open"
  ]
}